NEXT_PUBLIC_DATA_MODE=demo
# Set both URLs and change DATA_MODE to live after agreeing the backend contract.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# Server-only deployment profile. local-demo is rejected when NODE_ENV=production.
# Use public-demo only with simulated data and an isolated, non-sensitive demo.
# Production authentication is intentionally unavailable until the approved identity service exists.
BIODRY_DEPLOYMENT_PROFILE=local-demo

# Required for every enabled demo login. Generate at least 32 random characters.
# The placeholder below is deliberately rejected; never expose this with NEXT_PUBLIC_.
AUTH_SESSION_SECRET=generate-a-unique-random-secret-of-at-least-32-characters

# Required only for public-demo. Use at least 16 non-default characters and distribute privately.
# The source-defined local password is rejected in public-demo and production.
# DEMO_AUTH_PASSWORD=

# Server-only notification settings. Never prefix secrets with NEXT_PUBLIC_.
EMAIL_PROVIDER=mailersend
MAILERSEND_API_TOKEN=replace-with-mailersend-email-token
ALERT_EMAIL_FROM=BioDry Alerts <alerts@your-mailersend-test-or-verified-domain.example>
ALERT_EMAIL_TO=recipient@example.com
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_TO=replace-with-line-user-group-or-room-id

# Provider tests are restricted to local-demo and are always disabled in public-demo/production.
NOTIFICATION_TEST_ENABLED=false
