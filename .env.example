# Local Docker Compose settings. Copy this file to .env and set a unique password.
POSTGRES_DB=biodry
POSTGRES_USER=biodry
POSTGRES_PASSWORD=
FRONTEND_PORT=3000
BIODRY_SESSION_HOURS=8
# Provisional policy pending professor confirmation.
BIODRY_STAFF_EDIT_WINDOW_HOURS=24

# The Compose frontend uses database authentication and same-origin /api/v1 requests.
BIODRY_AUTH_MODE=backend
NEXT_PUBLIC_RESEARCH_API_MODE=backend

# Temperature telemetry intentionally remains simulated for Issue #3.
NEXT_PUBLIC_DATA_MODE=demo

# Optional non-Compose frontend development. The browser still calls /api/v1;
# Next.js uses this server-only address to reach FastAPI.
BACKEND_INTERNAL_URL=http://localhost:8000
BIODRY_FRONTEND_ORIGIN=http://localhost:3000

# Prototype-only login settings for running the old standalone demo without FastAPI.
# These are ignored when BIODRY_AUTH_MODE=backend.
BIODRY_DEPLOYMENT_PROFILE=local-demo
AUTH_SESSION_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
# DEMO_AUTH_PASSWORD=

# Notification delivery is not part of the local three-container milestone.
NOTIFICATION_TEST_ENABLED=false
EMAIL_PROVIDER=mailersend
MAILERSEND_API_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TO=
